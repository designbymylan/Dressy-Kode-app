{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dressy",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "dressy-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "maquettes",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tools/serve.mjs"
      ],
      "port": 4173
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mobile",
        "run",
        "web",
        "--",
        "--port",
        "8081"
      ],
      "port": 8081
    }
  ]
}
